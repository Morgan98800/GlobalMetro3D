{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "core/**",
      "cities/**/*.ts",
      "engine/**/*.ts",
      "engine/**/*.js",
      "web/src/**",
      "web/*.ts",
      "tests/**/*.ts",
      "tests/**/*.mjs",
      "tests/**/*.js",
      "netlify/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off",
        "useOptionalChain": "off",
        "noImportantStyles": "off",
        "noUselessUndefinedInitialization": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "off",
        "useImportType": "off",
        "noDescendingSpecificity": "off",
        "useExponentiationOperator": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noDuplicateProperties": "off",
        "noConfusingVoidType": "off"
      },
      "correctness": {
        "noUnusedFunctionParameters": "off"
      }
    }
  }
}
