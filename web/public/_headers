/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/data/*
  # Les artefacts GTFS gardent leur nom entre deux publications. Ils doivent
  # donc être revalidés pour ne jamais conserver un ancien réseau en cache.
  Cache-Control: public, max-age=0, must-revalidate

/cities/*/data/*
  Cache-Control: public, max-age=0, must-revalidate

