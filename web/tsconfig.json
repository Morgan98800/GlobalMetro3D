{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["vite/client"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["../core/*"],
      "@city/*": ["../cities/paris/*"],
      "@cities/*": ["../cities/*"],
      "@cities": ["../cities/index.ts"],
      "@paris-subway/shared": ["../core/index.ts"]
    }
  },
  "include": ["src", "../core", "../cities"],
  "exclude": ["src/**/*.test.ts", "../core/**/*.test.ts"]
}
